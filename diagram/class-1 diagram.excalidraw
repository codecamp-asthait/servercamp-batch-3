    {
      "id": "9NxIhfMBOe97FoKgQYIV9",
      "type": "text",
      "x": 454.2342348385191,
      "y": 65143.36263608285,
      "width": 2632.7686335477,
      "height": 213.6987466733354,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "#ffec99",
      "fillStyle": "solid",
      "strokeWidth": 4,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [
        "XfYtqfM5ysBljZ6h8YGaB"
      ],
      "frameId": null,
      "index": "bXp",
