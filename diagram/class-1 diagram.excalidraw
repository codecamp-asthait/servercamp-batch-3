      "seed": 1091330528,
      "version": 238,
      "versionNonce": 2044150401,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1772387715756,
      "link": null,
      "locked": false,
      "text": "1. Client-Server Separation:",
      "fontSize": 170.95899733866833,
      "fontFamily": 8,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "1. Client-Server Separation:",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "h2abc9zpMJD4-obQlfMP4",
      "type": "text",
      "x": 723.9597494758436,
      "y": 65414.41942084665,
      "width": 4513.317604273051,
      "height": 641.0962400200061,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "#ffec99",
      "fillStyle": "solid",
      "strokeWidth": 4,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [
        "XfYtqfM5ysBljZ6h8YGaB"
      ],
      "frameId": null,
      "index": "bXq",
      "roundness": null,
      "seed": 1842031648,
      "version": 221,
      "versionNonce": 2108508769,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1772387715756,
      "link": null,
      "locked": false,
      "text": "- Separate the user interface (client) from the\ndata and business logic (server) so that both of\nthem can evolve independently.",
      "fontSize": 170.9589973386683,
      "fontFamily": 8,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "- Separate the user interface (client) from the data and business logic (server) so that both of them can evolve independently.",
      "autoResize": false,
      "lineHeight": 1.25
    },
    {
      "id": "G1B39YjkuJMRA3Q73vE4v",
      "type": "text",
      "x": 451.3852763201994,
      "y": 66180.2711923038,
      "width": 1589.5,
      "height": 213.6987466733354,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "#ffec99",
      "fillStyle": "solid",
      "strokeWidth": 4,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [
        "XfYtqfM5ysBljZ6h8YGaB"
      ],
      "frameId": null,
      "index": "bXr",
      "roundness": null,
      "seed": 149235168,
      "version": 218,
      "versionNonce": 1295472193,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1772387715756,
      "link": null,
      "locked": false,
      "text": "2. Statelessness:",
      "fontSize": 170.95899733866833,
      "fontFamily": 8,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "2. Statelessness:",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "_NfJOPmzj_HXZcZ3ODHXv",
      "type": "text",
      "x": 773.9597494758436,
      "y": 66484.47860373095,
      "width": 4513.317604273051,
      "height": 854.7949866933416,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "#ffec99",
      "fillStyle": "solid",
      "strokeWidth": 4,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [
        "XfYtqfM5ysBljZ6h8YGaB"
      ],
      "frameId": null,
      "index": "bXs",
      "roundness": null,
      "seed": 1070639136,
      "version": 231,
      "versionNonce": 1532290593,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1772387715756,
      "link": null,
      "locked": false,
      "text": "- Each request from the client must contain all\ninformation needed for the server to process it\nwhich will simplifies server design and improves\nscalability.",
      "fontSize": 170.9589973386683,
      "fontFamily": 8,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "- Each request from the client must contain all information needed for the server to process it which will simplifies server design and improves scalability.",
      "autoResize": false,
      "lineHeight": 1.25
    },
    {
      "id": "_lAjOTTcNugiXEKIvmeqR",
      "type": "text",
      "x": 483.3303606146128,
      "y": 67440.8784951981,
      "width": 1974.576381995515,
      "height": 213.6987466733354,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "#ffec99",
      "fillStyle": "solid",
      "strokeWidth": 4,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [
        "XfYtqfM5ysBljZ6h8YGaB"
      ],
      "frameId": null,
      "index": "bXt",
      "roundness": null,
      "seed": 1627744736,
      "version": 214,
      "versionNonce": 318077441,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1772387715756,
      "link": null,
      "locked": false,
      "text": "3. Uniform Interface:",
      "fontSize": 170.95899733866833,
      "fontFamily": 8,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "3. Uniform Interface:",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "Oalu7mjI9OWx07JrK-72j",
      "type": "text",
      "x": 856.9461370060235,
      "y": 67728.78465329859,
      "width": 4607.344829212695,
      "height": 427.3974933466708,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "#ffec99",
      "fillStyle": "solid",
      "strokeWidth": 4,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [
        "XfYtqfM5ysBljZ6h8YGaB"
      ],
      "frameId": null,
      "index": "bXu",
      "roundness": null,
      "seed": 734438432,
      "version": 195,
      "versionNonce": 1427673569,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1772387715756,
      "link": null,
      "locked": false,
      "text": "- A consistent way of interacting with resources.\nFor example,",
      "fontSize": 170.95899733866833,
      "fontFamily": 8,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "- A consistent way of interacting with resources. For example,",
      "autoResize": false,
      "lineHeight": 1.25
    },
    {
      "id": "Gv5gjPLFJ1V-myFa29-F0",
      "type": "text",
      "x": 1045.1382022276866,
      "y": 68204.08830474573,
      "width": 3290.960698769365,
      "height": 213.6987466733354,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "#ffec99",
      "fillStyle": "solid",
      "strokeWidth": 4,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [
        "XfYtqfM5ysBljZ6h8YGaB"
      ],
      "frameId": null,
      "index": "bXv",
      "roundness": null,
      "seed": 1417489888,
      "version": 285,
      "versionNonce": 919449025,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1772387715756,
      "link": null,
      "locked": false,
      "text": "- Resource identification via URIs.",
      "fontSize": 170.95899733866833,
      "fontFamily": 8,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "- Resource identification via URIs.",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "PJ0El05LGazf08n1VO5oJ",
      "type": "text",
      "x": 812.9185394053384,
      "y": 68491.99446284621,
      "width": 4795.4000244140625,
      "height": 427.3974933466708,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "#ffec99",
      "fillStyle": "solid",
      "strokeWidth": 4,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [
        "XfYtqfM5ysBljZ6h8YGaB"
      ],
      "frameId": null,
      "index": "bXw",
      "roundness": null,
      "seed": 530391072,
      "version": 193,
      "versionNonce": 2134134177,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1772387715756,
      "link": null,
      "locked": false,
      "text": "- Standard operation using HTTP methods (GET, POST,\nPUT, DELETE).",
      "fontSize": 170.95899733866833,
      "fontFamily": 8,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "- Standard operation using HTTP methods (GET, POST, PUT, DELETE).",
      "autoResize": false,
      "lineHeight": 1.25
    },
    {
      "id": "qyU95fR9QV29L3Aw-YAFr",
      "type": "text",
      "x": 822.9185394053384,
      "y": 68980.4487409567,
      "width": 4795.4000244140625,
      "height": 427.3974933466708,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "#ffec99",
      "fillStyle": "solid",
      "strokeWidth": 4,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [
        "XfYtqfM5ysBljZ6h8YGaB"
      ],
      "frameId": null,
      "index": "bXx",
      "roundness": null,
      "seed": 207385056,
      "version": 197,
      "versionNonce": 1702621569,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1772387715756,
      "link": null,
      "locked": false,
      "text": "- Self-descriptive messages (requests and responses\ncarry all necessary info)",
      "fontSize": 170.95899733866833,
      "fontFamily": 8,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "- Self-descriptive messages (requests and responses carry all necessary info)",
      "autoResize": false,
      "lineHeight": 1.25
    },
    {
      "id": "ncn3dxYa5uSwBYCgNdW5k",
      "type": "text",
      "x": 574.3714775198569,
      "y": 69475.75239240384,
      "width": 1692.4941481850242,
      "height": 213.6987466733354,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "#ffec99",
      "fillStyle": "solid",
      "strokeWidth": 4,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [
        "XfYtqfM5ysBljZ6h8YGaB"
      ],
      "frameId": null,
      "index": "bXy",
      "roundness": null,
      "seed": 1262754848,
      "version": 232,
      "versionNonce": 249829729,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1772387715756,
      "link": null,
      "locked": false,
      "text": "4. Layered System:",
      "fontSize": 170.95899733866833,
      "fontFamily": 8,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "4. Layered System:",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "loLKZ50YaNVIVOu-YQEYl",
      "type": "text",
      "x": 882.9185394053384,
      "y": 69769.95980383098,
      "width": 4795.4000244140625,
      "height": 854.7949866933416,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "#ffec99",
      "fillStyle": "solid",
      "strokeWidth": 4,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [
        "XfYtqfM5ysBljZ6h8YGaB"
      ],
      "frameId": null,
      "index": "bXz",
      "roundness": null,
      "seed": 263402976,
      "version": 236,
      "versionNonce": 1287406913,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1772387715756,
      "link": null,
      "locked": false,
      "text": "- Client communicate through intermediate layers\n(like proxies, gateways, or caches) without knowing\ntheir presence to supports scalability, security,\nand flexibility.",
      "fontSize": 170.95899733866833,
      "fontFamily": 8,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "- Client communicate through intermediate layers (like proxies, gateways, or caches) without knowing their presence to supports scalability, security, and flexibility.",
      "autoResize": false,
      "lineHeight": 1.25
    },
    {
      "id": "zx7HxaOdav0CPhOa4cMKG",
      "type": "text",
      "x": 605.4126875903639,
      "y": 70756.35969529813,
      "width": 1410.4117280440137,
      "height": 213.6987466733354,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "#ffec99",
      "fillStyle": "solid",
      "strokeWidth": 4,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [
        "XfYtqfM5ysBljZ6h8YGaB"
      ],
      "frameId": null,
      "index": "bY0",
      "roundness": null,
      "seed": 1621858336,
      "version": 216,
      "versionNonce": 442758433,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1772387715756,
      "link": null,
      "locked": false,
      "text": "5. Cachebility:",
      "fontSize": 170.95899733866833,
      "fontFamily": 8,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "5. Cachebility:",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "lcwBTmrW-iXvvwsCsF4JI",
      "type": "text",
      "x": 869.9323382056791,
      "y": 71057.41648006195,
      "width": 4701.372426813378,
      "height": 641.0962400200061,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "#ffec99",
      "fillStyle": "solid",
      "strokeWidth": 4,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [
        "XfYtqfM5ysBljZ6h8YGaB"
      ],
      "frameId": null,
      "index": "bY1",
      "roundness": null,
      "seed": 59865568,
      "version": 229,
      "versionNonce": 1531619585,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1772387715756,
      "link": null,
      "locked": false,
      "text": "1. Responses explicitly indicate if they can be\ncached so that server load reduces and improve the\nperformance.",
      "fontSize": 170.9589973386683,
      "fontFamily": 8,
      "textAlign": "left",
