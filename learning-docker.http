@baseUrl = http://localhost:8080

### Get all todos
GET {{baseUrl}}/todos
Accept: application/json

###

### Get todo by id
GET {{baseUrl}}/todos/1
Accept: application/json

###

### Create todo
POST {{baseUrl}}/todos
Content-Type: application/json

{
  "title": "Learn Docker 1"
}

###

### Update todo
PUT {{baseUrl}}/todos/1
Content-Type: application/json

{
  "title": "Learn Docker Compose"
}

###

### Mark todo as complete
PATCH {{baseUrl}}/todos/1/complete

###

### Delete todo
DELETE {{baseUrl}}/todos/1

###
